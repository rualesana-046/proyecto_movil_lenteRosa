    <!-- Aviso de privacidad (RNF-01) -->
    <string name="privacy_title">Tu privacidad</string>
    <string name="privacy_location_title">Tu ubicación</string>
    <string name="privacy_location_body">Lente Rosa no guarda tu ubicación ni sigue tus movimientos. Solo la usa, de forma aproximada, si tocas «Cerca de mí», para buscar lugares en ese momento.</string>
    <string name="privacy_map_title">El mapa</string>
    <string name="privacy_map_body">Las imágenes del mapa las entrega %1$s. Ese servicio puede ver qué zona del mapa estás mirando y la dirección IP técnica de tu conexión, pero no sabe quién eres: Lente Rosa no le envía tu nombre, tu correo ni tu cuenta.</string>
    <string name="privacy_reviews_title">Tus opiniones</string>
    <string name="privacy_reviews_body">Tus opiniones se publican de forma anónima: nadie ve tu nombre ni tu correo. Si eliminas tu cuenta, tus opiniones se conservan, pero ya nadie puede saber que fueron tuyas.</string>
